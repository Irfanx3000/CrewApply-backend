# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# This API's own public base URL — must be the real reachable URL in
# production (e.g. https://api.crewapply.com), or embedded assets (e.g. the
# email logo) won't render for recipients. Defaults to http://localhost:PORT.
PUBLIC_URL=http://localhost:5000

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ─────────────────────────────────────────────
# JWT
# Generate strong secrets: node -e "require('crypto').randomBytes(64).toString('hex')"
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=<64-byte-hex-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<64-byte-hex-secret-different-from-access>
JWT_REFRESH_EXPIRES_IN=60d
JWT_REFRESH_EXPIRES_IN_DAYS=60

# ─────────────────────────────────────────────
# EMAIL (transactional — sent via Resend, see RESEND_API_KEY below)
# EMAIL_FROM is the sender address for OTP/verification/password-reset/
# application-status/admin-invite emails specifically (distinct from
# RESEND_FROM_EMAIL, the alerts@ address job-alert/consultancy/subscription
# emails use) — purely cosmetic, both go through the same Resend account.
# ─────────────────────────────────────────────
EMAIL_FROM=CrewApply <noreply@crewapply.com>

# ─────────────────────────────────────────────
# CLIENT
# ─────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
# CrewApply-admin (separate deployment) — used to link the admin-invite email
# to its Accept Invite screen.
ADMIN_CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
# GOOGLE OAUTH
# From Google Cloud Console → APIs & Services → Credentials
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# ─────────────────────────────────────────────
# SMS / OTP (Twilio)
# Leave the TWILIO_* vars blank to skip real SMS. For a TEST deployment without
# Twilio, set SMS_DEBUG=true to print OTP codes to the server logs (Railway logs).
# For a real production release: configure Twilio and keep SMS_DEBUG unset/false.
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_DEBUG=false

# ─────────────────────────────────────────────
# PAYMENTS (Razorpay)
# Dashboard → Settings → API Keys (use rzp_test_* for testing).
# Webhook secret: Dashboard → Settings → Webhooks → your webhook's secret.
# Only RAZORPAY_KEY_ID is ever sent to the client. Leave blank to disable payments.
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# PUSH NOTIFICATIONS (Firebase Admin)
# Firebase Console → Project Settings → Service Accounts → Generate new private
# key → downloads a JSON file. Base64-encode it: base64 -w0 serviceAccountKey.json
# Leave blank to disable push sends (in-app notifications still work).
# ─────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─────────────────────────────────────────────
# EMAIL TRANSPORT (Resend)
# Every transactional/lifecycle email in the app — OTP, verification,
# password reset, application status, admin invite, job alerts, subscription
# success, consultancy booking received/confirmed/rejected — sends through
# this one Resend account. Get an API key from resend.com → API Keys.
# Leave blank to disable all email sends (every other feature keeps working;
# sends silently no-op, same as push notifications without Firebase).
# ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=CrewApply <alerts@crewapply.com>
